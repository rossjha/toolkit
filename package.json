{
  "name": "toolkit",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "up": "npm run up --workspaces",
    "down": "npm run down --workspaces",
    "status": "docker compose ls"
  },
  "overrides": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "lodash-es": "^4.18.1",
    "katex": "^0.18.2",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    }
  }
}
