{
  "name": "atlassian-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.web.json && tailwindcss -i src/web/styles.css -o public/app.css --minify && node scripts/build-scratchpad.ts",
    "start": "npm run build && node src/server/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.scratchpad.json",
    "setup": "node scripts/setup.ts",
    "pack": "node scripts/pack.ts",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "marked": "^18.1.3",
    "yaml": "^2.9.1"
  }
}
